---
// src/pages/blogs-vlogs.astro
import Layout from '../layouts/Layout.astro';

const mediaEntries = [
  {
    id: "vlog-01",
    type: "VLOG",
    number: "EP // 01",
    title: "Inside Surat's High-Speed Water Jet Textile Looms",
    category: "Manufacturing Teardown",
    date: "OCT 2026",
    duration: "18:42",
    youtubeId: "LXb3EKWsInQ",
    desc: "An on-ground documentary dissecting yarn preparation, water jet weaving speeds, and wholesale billing workflows across Surat's largest textile clusters.",
    takeaways: ["120k meters/day capacity", "Water jet vs Rapier loom cost math", "Wholesale distribution channels"]
  },
  {
    id: "blog-01",
    type: "BLOG",
    number: "ANALYSIS // 01",
    title: "Cold-Press Edible Oil Margin Breakdown: APMC to Retail Tin",
    category: "Trade Intelligence",
    date: "OCT 2026",
    readTime: "6 min read",
    youtubeId: "ScMzIvxBSi4",
    desc: "A field intelligence report on soybean and groundnut cold-pressing: raw seed acquisition formulas, DOC byproduct recovery, and wholesale packaging margins.",
    takeaways: ["Raw seed procurement yield math", "Byproduct de-oiled cake (DOC) pricing", "15L wholesale tin packaging overheads"]
  },
  {
    id: "vlog-02",
    type: "VLOG",
    number: "EP // 02",
    title: "Bhiwandi Midnight Logistics: How 40 Trucks Clear Every Night",
    category: "Supply Chain Arteries",
    date: "SEP 2026",
    duration: "22:15",
    youtubeId: "L_LUpnjgPso",
    desc: "Night-shift coverage at western India's primary freight interchange. How cross-docking, pallet sorting, and automated dispatch prevent supply bottlenecks.",
    takeaways: ["Transit depot throughput systems", "Consignment tracking realities", "Tier-2 retail merchant dispatch"]
  },
  {
    id: "blog-02",
    type: "BLOG",
    number: "ANALYSIS // 02",
    title: "Sand Casting vs CNC Forging: Tier-2 Automotive Spares Quality Audit",
    category: "Industrial Engineering",
    date: "SEP 2026",
    readTime: "8 min read",
    youtubeId: "dQw4w9WgXcQ",
    desc: "Direct foundry metallurgical tests from Delhi-NCR: tolerance testing, mold metallurgy, and why tier-2 replacement suppliers are displacing import monopolies.",
    takeaways: ["Micron tolerance quality controls", "Molding sand reuse economics", "Wholesale dealer credit cycles"]
  },
  {
    id: "vlog-03",
    type: "VLOG",
    number: "EP // 03",
    title: "Agro Seed Extraction & APMC Mandi Procurement Logistics",
    category: "Agro Commodity",
    date: "AUG 2026",
    duration: "19:50",
    youtubeId: "ScMzIvxBSi4",
    desc: "From farmer arrivals at the APMC yard to automated packaging into wholesale containers for tier-2 distribution hubs.",
    takeaways: ["Daily cold press yields", "Auction bidding mechanics", "Storage loss mitigations"]
  },
  {
    id: "blog-03",
    type: "BLOG",
    number: "ANALYSIS // 03",
    title: "The B2B Wholesale Credit Cycle & Working Capital Traps",
    category: "Trade Economics",
    date: "AUG 2026",
    readTime: "5 min read",
    youtubeId: "LXb3EKWsInQ",
    desc: "How delayed 90-day trade credit lines impact mid-tier manufacturers and practical frameworks to reconcile receivables faster.",
    takeaways: ["Credit reconciliation rules", "Discounts for upfront settlements", "Inventory holding thresholds"]
  }
];
---

<Layout title="Blogs & Vlogs | Vyaparnama Field Media">
  <main class="relative z-10 text-white selection:bg-[#FF4D00] selection:text-black bg-transparent">

    <!-- ==================== HEADER SECTION ==================== -->
    <section class="min-h-[38vh] flex flex-col justify-end px-5 sm:px-8 lg:px-12 pt-32 pb-8 max-w-7xl mx-auto box-border">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-5 mb-8">
        <div class="flex items-center gap-3 font-mono text-xs">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FF4D00]/20 border border-[#FF4D00]/50 text-[#FF4D00] backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-[#FF4D00] animate-ping"></span>
            BROADCAST ARCHIVE
          </span>
          <span class="text-white/60 tracking-wider hidden sm:inline-block font-semibold">
            VISHWALATA VENTURES PRIVATE LIMITED
          </span>
        </div>
        <div class="font-mono text-xs text-white/70">
          Documentaries & Written Trade Intelligence
        </div>
      </div>

      <div class="max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/15 text-[11px] font-mono text-white/90 uppercase tracking-widest">
          The Business Storytelling Channel
        </div>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black uppercase tracking-tight text-white leading-[0.95]">
          Field Blogs & <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-white/90 to-[#FF4D00]">
            Visual Vlogs.
          </span>
        </h1>
        <p class="text-white/80 text-sm sm:text-base font-light leading-relaxed">
          Ground-reality trade breakdowns, manufacturer walkthroughs, and business challenge teardowns across India's industrial corridors.
        </p>
      </div>

      <!-- Filter Controls -->
      <div class="flex items-center gap-2 pt-6 border-b border-white/10 font-mono text-xs uppercase tracking-wider">
        <button id="filter-all" class="filter-btn px-3.5 py-2 rounded-t-lg border-b-2 border-[#FF4D00] text-white font-bold transition-all">
          All Logs ({mediaEntries.length})
        </button>
        <button id="filter-vlog" class="filter-btn px-3.5 py-2 rounded-t-lg border-b-2 border-transparent text-white/60 hover:text-white transition-all">
          Video Vlogs
        </button>
        <button id="filter-blog" class="filter-btn px-3.5 py-2 rounded-t-lg border-b-2 border-transparent text-white/60 hover:text-white transition-all">
          Written Case Studies
        </button>
      </div>

    </section>

    <!-- ==================== COMPACT 3-COLUMN INDUSTRIAL GRID ==================== -->
    <section class="px-5 sm:px-8 lg:px-12 py-8 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="media-grid">
        {mediaEntries.map((item) => (
          <article 
            class="media-card group flex flex-col justify-between p-4 rounded-2xl bg-black/60 backdrop-blur-xl border border-white/15 hover:border-[#FF4D00]/60 transition-all duration-300 shadow-[0_10px_30px_rgba(0,0,0,0.55)]"
            data-type={item.type}
          >
            <div>
              <!-- Compact Frame Container (autoplay disabled) -->
              <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-black/90 border border-white/10 mb-3 shadow-inner">
                <!-- Frame Reticle Accents -->
                <div class="absolute top-2 left-2 w-2.5 h-2.5 border-t-2 border-l-2 border-[#FF4D00] z-20 pointer-events-none"></div>
                <div class="absolute top-2 right-2 w-2.5 h-2.5 border-t-2 border-r-2 border-[#FF4D00] z-20 pointer-events-none"></div>
                <div class="absolute bottom-2 left-2 w-2.5 h-2.5 border-b-2 border-l-2 border-[#FF4D00] z-20 pointer-events-none"></div>
                <div class="absolute bottom-2 right-2 w-2.5 h-2.5 border-b-2 border-r-2 border-[#FF4D00] z-20 pointer-events-none"></div>

                <iframe
                  class="w-full h-full object-cover"
                  src={`https://www.youtube-nocookie.com/embed/${item.youtubeId}?autoplay=0&controls=1&rel=0&modestbranding=1`}
                  title={item.title}
                  frameborder="0"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              </div>

              <!-- Metadata Row -->
              <div class="flex items-center justify-between pb-2 mb-2.5 border-b border-white/10 font-mono text-[11px]">
                <div class="flex items-center gap-2">
                  <span class={`px-2 py-0.5 rounded text-[10px] font-bold ${
                    item.type === 'VLOG' 
                      ? 'bg-[#FF4D00]/20 text-[#FF4D00] border border-[#FF4D00]/40' 
                      : 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40'
                  }`}>
                    {item.type}
                  </span>
                  <span class="text-white/50">{item.number}</span>
                </div>
                <span class="text-white/60">
                  {item.type === 'VLOG' ? `⏱ ${item.duration}` : `📖 ${item.readTime}`}
                </span>
              </div>

              <!-- Category & Title -->
              <div class="font-mono text-[10px] text-[#FF4D00] tracking-wider uppercase mb-1">
                {item.category}
              </div>
              <h2 class="text-base font-bold uppercase tracking-tight text-white mb-2 group-hover:text-[#FF4D00] transition-colors leading-snug line-clamp-2">
                {item.title}
              </h2>

              <p class="text-xs text-white/70 font-light leading-relaxed mb-3 line-clamp-2">
                {item.desc}
              </p>

              <!-- Field Takeaways Strip -->
              <div class="space-y-1 pt-2.5 border-t border-white/10">
                <span class="font-mono text-[9px] uppercase tracking-wider text-white/40 block mb-1">
                  Field Insights:
                </span>
                {item.takeaways.slice(0, 2).map((point) => (
                  <div class="flex items-center gap-1.5 text-[11px] text-white/80 font-light truncate">
                    <span class="text-[#FF4D00] text-[8px] flex-shrink-0">■</span>
                    <span class="truncate">{point}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Footer Strip -->
            <div class="pt-3 mt-3 border-t border-white/10 flex items-center justify-between font-mono text-[10px]">
              <span class="text-white/40">{item.date}</span>
              <a
                href={`https://www.youtube.com/watch?v=${item.youtubeId}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-white/80 group-hover:text-[#FF4D00] transition-colors font-bold"
              >
                <span>YouTube</span>
                <span>↗</span>
              </a>
            </div>

          </article>
        ))}
      </div>
    </section>

    <!-- ==================== CALL TO ACTION ==================== -->
    <section class="px-5 sm:px-8 lg:px-12 py-12 max-w-7xl mx-auto">
      <div class="p-6 sm:p-8 rounded-2xl bg-black/60 backdrop-blur-xl border border-white/15 relative overflow-hidden shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="max-w-xl space-y-1.5">
          <span class="font-mono text-xs uppercase tracking-widest text-[#FF4D00] font-bold block">
            // YouTube Channel Network
          </span>
          <h3 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-white">
            Never miss a ground factory teardown.
          </h3>
          <p class="text-xs sm:text-sm text-white/70 font-light leading-relaxed">
            Subscribe to Vyaparnama for field documentaries, unlisted manufacturing economics, and honest founder challenges across Indian hubs.
          </p>
        </div>

        <a
          href="https://www.youtube.com/@vyaparnama"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 rounded-xl bg-[#FF4D00] text-white font-mono text-xs font-bold uppercase tracking-wider hover:bg-[#e04400] transition-colors shadow-[0_0_20px_rgba(255,77,0,0.35)] inline-flex items-center gap-2 shrink-0"
        >
          <span>Subscribe on YouTube</span>
          <span>▶</span>
        </a>
      </div>
    </section>

  </main>
</Layout>

<script>
  import { gsap } from 'gsap';

  const initBlogVlogFilters = () => {
    const filterAll = document.getElementById('filter-all');
    const filterVlog = document.getElementById('filter-vlog');
    const filterBlog = document.getElementById('filter-blog');
    const buttons = [filterAll, filterVlog, filterBlog];
    const cards = document.querySelectorAll<HTMLElement>('.media-card');

    const setFilter = (type: string, activeBtn: HTMLElement | null) => {
      buttons.forEach((btn) => {
        btn?.classList.remove('border-[#FF4D00]', 'text-white', 'font-bold');
        btn?.classList.add('border-transparent', 'text-white/60');
      });
      activeBtn?.classList.add('border-[#FF4D00]', 'text-white', 'font-bold');
      activeBtn?.classList.remove('border-transparent', 'text-white/60');

      cards.forEach((card) => {
        const cardType = card.dataset.type;
        if (type === 'ALL' || cardType === type) {
          gsap.to(card, {
            autoAlpha: 1,
            scale: 1,
            duration: 0.25,
            display: 'flex',
            ease: 'power2.out'
          });
        } else {
          gsap.to(card, {
            autoAlpha: 0,
            scale: 0.96,
            duration: 0.2,
            display: 'none',
            ease: 'power2.in'
          });
        }
      });
    };

    filterAll?.addEventListener('click', () => setFilter('ALL', filterAll));
    filterVlog?.addEventListener('click', () => setFilter('VLOG', filterVlog));
    filterBlog?.addEventListener('click', () => setFilter('BLOG', filterBlog));
  };

  document.addEventListener('DOMContentLoaded', initBlogVlogFilters);
  document.addEventListener('astro:page-load', initBlogVlogFilters);
</script>