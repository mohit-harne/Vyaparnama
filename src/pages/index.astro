<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const initHomePage = () => {
    // 1. Snappy hero reveal
    gsap.fromTo(
      '.hero-reveal',
      { y: 15, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.35, stagger: 0.05, ease: 'power2.out' }
    );

    // 2. Video Player Controls Setup
    const video = document.getElementById('hero-broadcast-video') as HTMLVideoElement;
    const btnPlay = document.getElementById('btn-video-play');
    const labelPlay = document.getElementById('label-play');
    const iconPlay = document.getElementById('icon-play');
    const iconPause = document.getElementById('icon-pause');

    const btnAudio = document.getElementById('btn-video-audio');
    const labelAudio = document.getElementById('label-audio');
    const iconMuted = document.getElementById('icon-muted');
    const iconSound = document.getElementById('icon-sound');

    if (video) {
      btnPlay?.addEventListener('click', () => {
        if (video.paused) {
          video.play();
          if (labelPlay) labelPlay.textContent = 'Pause';
          iconPause?.classList.remove('hidden');
          iconPlay?.classList.add('hidden');
        } else {
          video.pause();
          if (labelPlay) labelPlay.textContent = 'Play';
          iconPause?.classList.add('hidden');
          iconPlay?.classList.remove('hidden');
        }
      });

      btnAudio?.addEventListener('click', () => {
        video.muted = !video.muted;
        if (video.muted) {
          if (labelAudio) labelAudio.textContent = 'Unmute';
          iconMuted?.classList.remove('hidden');
          iconSound?.classList.add('hidden');
        } else {
          if (labelAudio) labelAudio.textContent = 'Mute';
          iconMuted?.classList.add('hidden');
          iconSound?.classList.remove('hidden');
        }
      });
    }

    // 3. Fast scroll entrance for Venture Cards
    const ventureCards = document.querySelectorAll('.venture-card');
    if (ventureCards.length) {
      gsap.fromTo(
        ventureCards,
        { y: 20, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.4,
          stagger: 0.08,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '.ventures-container',
            start: 'top 85%',
          }
        }
      );
    }
  };

  document.addEventListener('DOMContentLoaded', initHomePage);
  document.addEventListener('astro:page-load', initHomePage);
</script>