---
// src/components/Background3D.astro
---

<div id="bg-canvas-container" class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
  <canvas id="bg-webgl" class="w-full h-full block opacity-85"></canvas>
</div>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';

  function initCinematicField() {
    const canvas = document.getElementById('bg-webgl') as HTMLCanvasElement;
    if (!canvas) return;

    // Reset dimensions explicitly
    const width = window.innerWidth;
    const height = window.innerHeight;

    // 1. Scene, Camera & Lights
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.z = 20;

    // 2. High-Precision Renderer with transparent alpha
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const worldGroup = new THREE.Group();
    scene.add(worldGroup);

    // 3. Crisp High-Contrast Crosshair Texture Generation
    const crosshairCanvas = document.createElement('canvas');
    crosshairCanvas.width = 128;
    crosshairCanvas.height = 128;
    const ctx = crosshairCanvas.getContext('2d')!;

    // Outer Target Bracket
    ctx.strokeStyle = '#FF4D00';
    ctx.lineWidth = 6;
    ctx.beginPath();
    ctx.arc(64, 64, 48, 0, Math.PI * 2);
    ctx.stroke();

    // Center Crosshair Lines
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.moveTo(64, 16); ctx.lineTo(64, 44);
    ctx.moveTo(64, 84); ctx.lineTo(64, 112);
    ctx.moveTo(16, 64); ctx.lineTo(44, 64);
    ctx.moveTo(84, 64); ctx.lineTo(112, 64);
    ctx.stroke();

    // Center Core Dot
    ctx.fillStyle = '#FFFFFF';
    ctx.beginPath();
    ctx.arc(64, 64, 6, 0, Math.PI * 2);
    ctx.fill();

    const crosshairTex = new THREE.CanvasTexture(crosshairCanvas);
    crosshairTex.colorSpace = THREE.SRGBColorSpace;

    // 4. Point Cloud Particles (Larger and fully visible)
    const particleCount = 85;
    const posArray = new Float32Array(particleCount * 3);
    const bounds = { x: 28, y: 18, z: 14 };

    for (let i = 0; i < particleCount * 3; i += 3) {
      posArray[i] = (Math.random() - 0.5) * bounds.x * 2;
      posArray[i + 1] = (Math.random() - 0.5) * bounds.y * 2;
      posArray[i + 2] = (Math.random() - 0.5) * bounds.z * 2;
    }

    const particlesGeometry = new THREE.BufferGeometry();
    particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));

    const particlesMaterial = new THREE.PointsMaterial({
      size: 1.6,
      map: crosshairTex,
      transparent: true,
      opacity: 0.75,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });

    const pointCloud = new THREE.Points(particlesGeometry, particlesMaterial);
    worldGroup.add(pointCloud);

    // 5. Glowing Focus Rings (Apertures)
    const rings: THREE.Mesh[] = [];
    const ringGeo = new THREE.RingGeometry(3.5, 3.56, 64);

    for (let i = 0; i < 5; i++) {
      const ringMat = new THREE.MeshBasicMaterial({
        color: i % 2 === 0 ? 0xFF4D00 : 0xFFFFFF,
        transparent: true,
        opacity: i % 2 === 0 ? 0.35 : 0.15,
        side: THREE.DoubleSide,
      });

      const ring = new THREE.Mesh(ringGeo, ringMat);
      ring.position.set(
        (i - 2) * 8.5,
        (Math.random() - 0.5) * 5,
        -6 + i * 2.5
      );
      ring.scale.setScalar(0.7 + i * 0.25);
      rings.push(ring);
      worldGroup.add(ring);
    }

    // 6. Camera Parallax Mouse Follow
    const mouse = { x: 0, y: 0 };
    const onPointerMove = (e: MouseEvent) => {
      const normX = (e.clientX / window.innerWidth - 0.5) * 2;
      const normY = -(e.clientY / window.innerHeight - 0.5) * 2;
      gsap.to(mouse, { x: normX, y: normY, duration: 1.5, ease: 'power2.out' });
    };
    window.addEventListener('pointermove', onPointerMove);

    // 7. Responsive Resize
    const onResize = () => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    };
    window.addEventListener('resize', onResize);

    // 8. Animation Loop with Safe Timestamp
    let animId: number;
    const startTime = performance.now();

    function renderLoop() {
      animId = requestAnimationFrame(renderLoop);

      const time = (performance.now() - startTime) * 0.001;

      // Slow orbital drift
      pointCloud.rotation.y = time * 0.035;
      pointCloud.rotation.x = Math.sin(time * 0.02) * 0.08;

      rings.forEach((r, idx) => {
        r.rotation.z = time * (0.04 + idx * 0.02);
      });

      worldGroup.position.x = mouse.x * 1.2;
      worldGroup.position.y = mouse.y * 0.8;

      renderer.render(scene, camera);
    }

    renderLoop();

    // Cleanup hook for Astro ViewTransitions
    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(animId);
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('resize', onResize);
        renderer.dispose();
      },
      { once: true }
    );
  }

  // Run on initial load and on Astro navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCinematicField);
  } else {
    initCinematicField();
  }

  document.addEventListener('astro:page-load', initCinematicField);
</script>