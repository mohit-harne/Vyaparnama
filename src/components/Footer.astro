---
const currentYear = new Date().getFullYear();

const socials = [
  { name: 'YouTube', href: 'https://www.youtube.com/@vyaparnama', handle: '@vyaparnama' },
  { name: 'Instagram', href: 'https://www.instagram.com/vyaparnama/', handle: '@vyaparnama' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/company/vyaparnama/?originalSubdomain=in', handle: 'vyaparnama' },
  { name: 'Facebook', href: 'https://www.facebook.com/vyaparnama', handle: 'vyaparnama' },
];
---

<footer class="relative border-t border-white/10 bg-[#060606] text-white pt-16 pb-10 overflow-hidden z-20">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand Teardown -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-[#FF4D00] text-xl font-black">▲</span>
          <span class="font-mono text-xl font-black tracking-tight uppercase">VYAPARNAMA</span>
        </div>
        <p class="text-white/60 text-sm font-light leading-relaxed max-w-sm">
          We visit Indian manufacturing mills, mandi trade hubs, and retail outlets to film authentic on-site documentaries that uncover true product value and connect B2B supply chains.
        </p>
        <div class="inline-flex items-center gap-2 font-mono text-[11px] text-emerald-400 bg-emerald-400/10 px-3 py-1 rounded-full border border-emerald-400/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Cinematic Crew En-Route: Western Maharashtra
        </div>
      </div>

      <!-- Quick Index -->
      <div class="md:col-span-3 space-y-2 font-mono text-xs">
        <span class="text-[#FF4D00] uppercase tracking-widest block mb-4">Field Access</span>
        <ul class="space-y-2 text-white/60">
          <li><a href="/stories" class="hover:text-white transition-colors">Featured Documentaries</a></li>
          <li><a href="/methodology" class="hover:text-white transition-colors">On-Site Teardown Process</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Invite Us to Your Location</a></li>
        </ul>
      </div>

      <!-- Direct Contact Desk -->
      <div class="md:col-span-4 space-y-3 font-mono text-xs">
        <span class="text-[#FF4D00] uppercase tracking-widest block mb-4">Direct Dispatch Desk</span>
        <div class="space-y-2">
          <p class="text-white/40">WhatsApp Production Line:</p>
          <a href="https://wa.me/919890229131" target="_blank" class="block text-sm font-bold text-emerald-400 hover:underline">
            +91 98902 29131
          </a>
          <p class="text-white/40 pt-1">Official Media Inquiries:</p>
          <a href="mailto:info@vyapo.com" class="block text-sm font-bold text-white hover:text-[#FF4D00]">
            info@vyapo.com
          </a>
        </div>
      </div>

    </div>

    <!-- Socials & Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-white/40">
      <div class="flex items-center gap-4">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="hover:text-[#FF4D00] transition-colors">
            {s.name}
          </a>
        ))}
      </div>
      <p>© {currentYear} Vyaparnama. On-location business documentaries.</p>
    </div>

  </div>
</footer>