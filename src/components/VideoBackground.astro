---
// src/components/Background3D.astro (or your gallery component)
const totalImages = 17;
const images = Array.from({ length: totalImages }, (_, i) => `/slideimages/slideimage${i + 1}.png`);

const rows = [
  {
    id: "row-1",
    direction: "left",
    duration: "45s",
    items: [images[0], images[1], images[2], images[3], images[4]],
  },
  {
    id: "row-2",
    direction: "right",
    duration: "38s",
    items: [images[5], images[6], images[7], images[8], images[9]],
  },
  {
    id: "row-3",
    direction: "left",
    duration: "48s",
    items: [images[10], images[11], images[12], images[13], images[14]],
  },
  {
    id: "row-4",
    direction: "right",
    duration: "40s",
    items: [images[15], images[16], images[0], images[2], images[5]],
  },
];
---

<div id="gallery-bg" aria-hidden="true">
  <div id="gallery-parallax">
    <div id="gallery-grid">
      {rows.map((row) => (
        <div
          class={`gallery-row ${row.direction === "left" ? "scroll-left" : "scroll-right"}`}
          style={`--marquee-duration: ${row.duration};`}
          data-row={row.id}
        >
          <div class="marquee-track">
            <!-- Group 1 -->
            <div class="marquee-group">
              {row.items.map((src) => (
                <div class="gallery-card">
                  <img
                    class="gallery-image"
                    src={src}
                    alt=""
                    loading="eager"
                    decoding="async"
                  />
                </div>
              ))}
            </div>

            <!-- Group 2 (Duplicate seamless loop) -->
            <div class="marquee-group marquee-clone" aria-hidden="true">
              {row.items.map((src) => (
                <div class="gallery-card">
                  <img
                    class="gallery-image"
                    src={src}
                    alt=""
                    loading="eager"
                    decoding="async"
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Readability Overlays: High visual clarity with preserved dark theme contrast -->
  <div class="gallery-overlay"></div>
  <div class="gallery-vignette"></div>
</div>

<style>
  #gallery-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    background: #080808;
    isolation: isolate;
  }

  #gallery-parallax {
    position: absolute;
    inset: -20% -10%;
    width: 120%;
    height: 140%;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  #gallery-grid {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    height: 100%;
    transform: rotate(-6deg) scale(1.06);
    transform-origin: center center;
    will-change: transform;
  }

  .gallery-row {
    width: 100%;
    height: 22%;
    min-height: 120px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    height: 100%;
    gap: 0;
    will-change: transform;
  }

  .marquee-group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding-right: 1rem;
  }

  .gallery-card {
    position: relative;
    flex: 0 0 clamp(240px, 20vw, 340px);
    height: 100%;
    aspect-ratio: 16 / 9;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background: #141414;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
  }

  .gallery-image {
    display: block;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.9) contrast(1.05);
    transform: translateZ(0);
  }

  .scroll-left .marquee-track {
    animation: gallery-scroll-left var(--marquee-duration, 45s) linear infinite;
  }

  .scroll-right .marquee-track {
    animation: gallery-scroll-right var(--marquee-duration, 38s) linear infinite;
  }

  .gallery-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0.78) 0%,
      rgba(10, 10, 10, 0.45) 50%,
      rgba(10, 10, 10, 0.85) 100%
    );
  }

  .gallery-vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(
      ellipse at center,
      transparent 20%,
      rgba(10, 10, 10, 0.6) 70%,
      rgba(8, 8, 8, 0.92) 100%
    );
  }

  @keyframes gallery-scroll-left {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes gallery-scroll-right {
    from {
      transform: translate3d(-50%, 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  /* --- MOBILE OPTIMIZATION: REMOVE EXCESS VERTICAL GAPS --- */
  @media (max-width: 768px) {
    #gallery-parallax {
      inset: -10% -15%;
      width: 130%;
      height: 120%;
    }

    #gallery-grid {
      gap: 0.35rem; /* Tightened vertical gap between row strips */
      transform: rotate(-5deg) scale(1.04);
      justify-content: center;
    }

    .gallery-row {
      height: 20%;
      min-height: 80px; /* Reduced floor to prevent tall row expansion */
      margin: 0;
      padding: 0;
    }

    .marquee-group {
      gap: 0.5rem; /* Tightened horizontal card gap */
      padding-right: 0.5rem;
    }

    .gallery-card {
      flex: 0 0 clamp(160px, 46vw, 210px);
      height: 100%; /* Fills row completely without leaving blank vertical margins */
      border-radius: 8px;
    }

    .gallery-overlay {
      background: linear-gradient(
        180deg,
        rgba(10, 10, 10, 0.85) 0%,
        rgba(10, 10, 10, 0.55) 50%,
        rgba(10, 10, 10, 0.9) 100%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-left .marquee-track,
    .scroll-right .marquee-track {
      animation-duration: 120s;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const initGallery = () => {
    // 1. Diagnostic test to verify path resolution in developer console
    const testImg = new Image();
    testImg.src = "/sliderimages/slideimage1.png";
    testImg.onerror = () => {
      console.warn(
        "[Gallery Alert]: Could not load '/sliderimages/slideimage1.png'. Verify that files exist under 'public/sliderimages/slideimage1.png' (case-sensitive on production servers)."
      );
    };

    // 2. Parallax registration
    const parallaxEl = document.getElementById("gallery-parallax");
    if (!parallaxEl) return;

    gsap.registerPlugin(ScrollTrigger);

    gsap.fromTo(
      parallaxEl,
      { yPercent: -6 },
      {
        yPercent: 6,
        ease: "none",
        scrollTrigger: {
          trigger: document.body,
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
          invalidateOnRefresh: true,
        },
      }
    );
  };

  document.addEventListener("DOMContentLoaded", initGallery);
  document.addEventListener("astro:page-load", initGallery);
</script>