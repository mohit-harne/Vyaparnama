---
const videos = Array.from({ length: 7 }, (_, index) => {
  return `/video/vyaparnama${index + 1}.mp4`;
});

const rows = [
  {
    id: "row-1",
    direction: "left",
    duration: "48s",
    videos: [videos[0], videos[1], videos[2], videos[3]],
  },
  {
    id: "row-2",
    direction: "right",
    duration: "42s",
    videos: [videos[4], videos[5], videos[6], videos[0]],
  },
  {
    id: "row-3",
    direction: "left",
    duration: "52s",
    videos: [videos[2], videos[4], videos[1], videos[5]],
  },
  {
    id: "row-4",
    direction: "right",
    duration: "45s",
    videos: [videos[6], videos[3], videos[0], videos[2]],
  },
];
---

<div id="gallery-bg" aria-hidden="true">
  <div id="gallery-parallax">
    <div id="gallery-grid">
      {rows.map((row) => (
        <div
          class={`gallery-row ${row.direction === "left" ? "scroll-left" : "scroll-right"}`}
          style={`--marquee-duration: ${row.duration};`}
          data-row={row.id}
        >
          <div class="marquee-track">
            <!-- Original group: these are the only playing videos. -->
            <div class="marquee-group">
              {row.videos.map((videoSrc, index) => (
                <div class="gallery-card">
                  <video
                    class="gallery-video"
                    src={videoSrc}
                    muted
                    loop
                    autoplay
                    playsinline
                    preload="metadata"
                    disablepictureinpicture
                    data-gallery-video
                    data-clone-key={`${row.id}-${index}`}
                  />
                </div>
              ))}
            </div>

            <!-- Duplicate group: image snapshots avoid extra video decoding. -->
            <div class="marquee-group marquee-clone" aria-hidden="true">
              {row.videos.map((videoSrc, index) => (
                <div class="gallery-card">
                  <img
                    class="gallery-video gallery-snapshot"
                    alt=""
                    loading="eager"
                    decoding="async"
                    data-snapshot-for={`${row.id}-${index}`}
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="gallery-overlay"></div>
  <div class="gallery-vignette"></div>
</div>

<style>
  #gallery-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    background: #060606;
    isolation: isolate;
  }

  #gallery-parallax {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    will-change: transform;
    transform: translate3d(0, var(--parallax-y, 0px), 0);
  }

  #gallery-grid {
    position: absolute;
    inset: -3%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    width: 106%;
    height: 106%;
    transform: rotate(-9deg) scale(1.05);
    transform-origin: center;
    will-change: transform;
  }

  .gallery-row {
    width: 100%;
    flex: 0 0 20%;
    min-height: 0;
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    height: 100%;
    gap: 0;
    will-change: transform;
  }

  .marquee-group {
    display: flex;
    flex: 0 0 auto;
    align-items: stretch;
    gap: 1rem;
    height: 100%;
    padding-right: 1rem;
  }

  .gallery-card {
    position: relative;
    flex: 0 0 clamp(220px, 25vw, 360px);
    height: 100%;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 12px;
    background: #101010;
    box-shadow: 0 12px 36px rgb(0 0 0 / 24%);
  }

  .gallery-video {
    display: block;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover;
    object-position: center;
  }

  .gallery-snapshot {
    opacity: 1;
  }

  .scroll-left .marquee-track {
    animation: gallery-scroll-left var(--marquee-duration, 48s) linear infinite;
  }

  .scroll-right .marquee-track {
    animation: gallery-scroll-right var(--marquee-duration, 42s) linear infinite;
  }

  .gallery-row:hover .marquee-track {
    animation-play-state: paused;
  }

  .gallery-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(
        180deg,
        rgb(6 6 6 / 58%) 0%,
        rgb(6 6 6 / 35%) 45%,
        rgb(6 6 6 / 76%) 100%
      );
  }

  .gallery-vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(
      ellipse at center,
      transparent 12%,
      rgb(0 0 0 / 28%) 72%,
      rgb(0 0 0 / 65%) 100%
    );
  }

  @keyframes gallery-scroll-left {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes gallery-scroll-right {
    from {
      transform: translate3d(-50%, 0, 0);
    }

    to {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (max-width: 768px) {
    #gallery-grid {
      inset: -4%;
      width: 108%;
      height: 108%;
      gap: 0.75rem;
      transform: rotate(-7deg) scale(1.04);
    }

    .gallery-row {
      flex-basis: 19%;
    }

    .marquee-group {
      gap: 0.75rem;
      padding-right: 0.75rem;
    }

    .gallery-card {
      flex-basis: clamp(190px, 48vw, 270px);
      border-radius: 8px;
    }
  }

  @media (max-width: 480px) {
    #gallery-grid {
      transform: rotate(-6deg) scale(1.03);
    }

    .gallery-card {
      flex-basis: 220px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-left .marquee-track,
    .scroll-right .marquee-track {
      animation-duration: 120s;
    }
  }
</style>

<script>
  function initialiseVideoGallery() {
    const gallery = document.getElementById("gallery-bg");

    if (!gallery || gallery.dataset.initialised === "true") {
      return;
    }

    gallery.dataset.initialised = "true";

    const videos = Array.from(
      gallery.querySelectorAll<HTMLVideoElement>("[data-gallery-video]")
    );

    let scrollFrame = 0;
    let snapshotAttempts = 0;

    const createSnapshot = (video: HTMLVideoElement) => {
      const key = video.dataset.cloneKey;

      if (!key || video.readyState < HTMLMediaElement.HAVE_CURRENT_DATA) {
        return;
      }

      const snapshot = gallery.querySelector<HTMLImageElement>(
        `[data-snapshot-for="${key}"]`
      );

      if (!snapshot || snapshot.dataset.ready === "true") {
        return;
      }

      try {
        const canvas = document.createElement("canvas");

        // Small snapshots reduce memory usage while preserving the background look.
        const targetWidth = 480;
        const aspectRatio =
          video.videoWidth > 0 && video.videoHeight > 0
            ? video.videoHeight / video.videoWidth
            : 9 / 16;

        canvas.width = targetWidth;
        canvas.height = Math.max(1, Math.round(targetWidth * aspectRatio));

        const context = canvas.getContext("2d", { alpha: false });

        if (!context) {
          return;
        }

        context.drawImage(video, 0, 0, canvas.width, canvas.height);

        snapshot.src = canvas.toDataURL("image/jpeg", 0.72);
        snapshot.dataset.ready = "true";
        canvas.width = 0;
        canvas.height = 0;
      } catch {
        // The animated track still works if a browser cannot create snapshots.
      }
    };

    const startVideo = (video: HTMLVideoElement) => {
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;

      const playPromise = video.play();

      if (playPromise && typeof playPromise.catch === "function") {
        playPromise.catch(() => {
          // Some browsers delay autoplay until the next interaction.
        });
      }
    };

    videos.forEach((video) => {
      video.addEventListener(
        "loadeddata",
        () => createSnapshot(video),
        { once: true }
      );

      video.addEventListener(
        "playing",
        () => createSnapshot(video),
        { once: true }
      );

      if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
        createSnapshot(video);
      }

      startVideo(video);
    });

    // Retry snapshot generation as videos finish loading, without a timer loop.
    gallery.addEventListener("loadeddata", (event) => {
      const target = event.target;

      if (target instanceof HTMLVideoElement) {
        createSnapshot(target);
      }

      snapshotAttempts += 1;

      if (snapshotAttempts > videos.length * 3) {
        return;
      }
    }, true);

    // Parallax changes only the outer wrapper; it never overwrites the grid rotation.
    const updateParallax = () => {
      if (scrollFrame) {
        return;
      }

      scrollFrame = window.requestAnimationFrame(() => {
        const scrollY = window.scrollY || 0;
        const parallaxOffset = Math.max(-70, Math.min(70, scrollY * -0.035));

        gallery.style.setProperty(
          "--parallax-y",
          `${parallaxOffset.toFixed(2)}px`
        );

        scrollFrame = 0;
      });
    };

    window.addEventListener("scroll", updateParallax, { passive: true });
    updateParallax();

    // Reattempt autoplay after a browser has deferred media playback.
    const retryPlayback = () => {
      videos.forEach((video) => {
        if (video.paused) {
          startVideo(video);
        }
      });
    };

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) {
        retryPlayback();
      }
    });

    window.addEventListener("pageshow", retryPlayback);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initialiseVideoGallery, {
      once: true,
    });
  } else {
    initialiseVideoGallery();
  }

  document.addEventListener("astro:page-load", initialiseVideoGallery);
</script>