---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import VideoBackground from '../components/VideoBackground.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Vyaparnama — On-location merchant documentaries from India's commercial heartlands." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
<body class="bg-[#060606] text-white min-h-screen overflow-x-hidden relative">
    <!-- Persistent background video gallery across entire website -->
    <VideoBackground />
    
    <Navbar />
    <main class="relative z-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
